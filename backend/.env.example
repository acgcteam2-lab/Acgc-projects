MONGO_URI=mongodb://127.0.0.1:27017/reactvite
JWT_SECRET=supersecretkey
# Generate a private 32-byte key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BACKUP_ENCRYPTION_KEY=replace_with_a_generated_64_character_hex_key
CRON_SECRET=replace_with_a_long_random_secret
# Google Cloud project ID and service account JSON (store the real JSON as a Vercel secret).
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_CREDENTIALS_JSON=PASTE_COMPLETE_SERVICE_ACCOUNT_JSON_ON_ONE_LINE
# Public media bucket and private encrypted-backup bucket.
GCS_MEDIA_BUCKET=your-public-media-bucket
GCS_BACKUP_BUCKET=your-private-backup-bucket
PORT=5000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_gmail_app_password_here
EMAIL_FROM="ACGC Site Inspection <yourgmail@gmail.com>"
