MONGO_URI=mongodb://127.0.0.1:27017/reactvite
# Optional DNS override for environments whose resolver refuses MongoDB SRV queries.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
JWT_SECRET=supersecretkey
# Use the value from Cloudinary's API environment variable field, or set the three variables below instead.
# CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Generate a private 32-byte key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BACKUP_ENCRYPTION_KEY=replace_with_a_generated_64_character_hex_key
CRON_SECRET=replace_with_a_long_random_secret
# Connect a public Blob store to the backend service; Vercel provides BLOB_READ_WRITE_TOKEN.
# Create a separate private Blob store with this token prefix for encrypted backups.
BLOB_PRIVATE_READ_WRITE_TOKEN=replace_with_private_blob_read_write_token
PORT=5000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_gmail_app_password_here
EMAIL_FROM="ACGC Site Inspection <yourgmail@gmail.com>"
