{
  "name": "reactvite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation concurrently -k --raw \"npm --prefix backend run dev\" \"node ./scripts/waitForBackend.cjs && npm run dev:frontend\"",
    "dev:debug": "cross-env DEBUG_API=true NODE_OPTIONS=--no-deprecation concurrently -k --raw \"npm --prefix backend run dev\" \"node ./scripts/waitForBackend.cjs && npm run dev:frontend\"",
    "dev:frontend": "vite --host 0.0.0.0",
    "dev:frontend:mobile": "vite --host 0.0.0.0",
    "dev:mobile": "concurrently -k -n backend,frontend -c blue,green \"npm --prefix backend run dev\" \"node ./scripts/waitForBackend.cjs && npm run dev:frontend:mobile\"",
    "dev:no-hmr": "vite --host 0.0.0.0 --no-hmr",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "verify:smtp": "npm --prefix backend run verify:smtp",
    "verify:cloudinary": "npm --prefix backend run verify:cloudinary",
    "start:backend": "cd backend && npm start",
    "dev:backend": "npm --prefix backend run dev",
    "dev:all": "npm run dev",
    "promote-admin": "cd backend && npm run promote-admin"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@tailwindcss/vite": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.17.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.16.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^8.2.1",
    "cross-env": "^7.0.3",
    "date-fns": "^2.30.0",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "kill-port": "^1.6.0",
    "shadcn": "^4.10.0",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^0.34.0"
  }
}
